{
  "buildCommand": "ng build",
  "outputDirectory": "dist/tpFinal/browser",
  "serverlessFunctionRegion": "us-east-1",
  "functions": {
    "src/server.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.mjs"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
